# Penalized Regression

```{r penalized-data}
x_train <- model.matrix(HeatingLoad ~ ., train_data)[, -1]
y_train <- train_data$HeatingLoad
x_test  <- model.matrix(HeatingLoad ~ ., test_data)[, -1]
y_test  <- test_data$HeatingLoad

# Reproduce the standard cv.glmnet display while using the homework palette.
# The vertical bars show +/- 1 standard error around the cross-validated mean.
# The numbers across the top show the number of nonzero coefficients.
plot_cv_glmnet_palette <- function(
  cvfit,
  point_col = plot_palette[2],
  error_col = plot_palette[4],
  line_col = plot_palette[5]
) {
  # Match the native plot.cv.glmnet orientation used in the reference code:
  # the horizontal axis is -Log(lambda), not Log(lambda).
  sign_lambda <- -1
  x <- sign_lambda * log(cvfit$lambda)
  y <- cvfit$cvm
  lower <- cvfit$cvlo
  upper <- cvfit$cvup

  plot(
    x, y,
    type = "n",
    ylim = range(c(lower, upper), finite = TRUE),
    xlab = expression(-Log(lambda)),
    ylab = if (!is.null(cvfit$name)) cvfit$name else "Mean-Squared Error",
    main = ""
  )

  cap_width <- diff(range(x)) / 250

  segments(
    x, lower, x, upper,
    col = error_col,
    lwd = 1
  )
  segments(
    x - cap_width, lower, x + cap_width, lower,
    col = error_col,
    lwd = 1
  )
  segments(
    x - cap_width, upper, x + cap_width, upper,
    col = error_col,
    lwd = 1
  )

  points(
    x, y,
    pch = 20,
    cex = 0.85,
    col = point_col
  )

  abline(
    v = sign_lambda * log(cvfit$lambda.min),
    lty = 3,
    lwd = 1,
    col = line_col
  )
  abline(
    v = sign_lambda * log(cvfit$lambda.1se),
    lty = 3,
    lwd = 1,
    col = line_col
  )

  # Use the same degrees-of-freedom/nonzero-coefficient information shown
  # across the top of the native cv.glmnet plot.
  nz <- if (!is.null(cvfit$nzero)) cvfit$nzero else cvfit$nz

  axis(
    3,
    at = x,
    labels = nz,
    tick = FALSE,
    line = 0
  )
}
```

