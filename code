}

energy_raw <- energy_raw[, required_columns]

if (!all(vapply(energy_raw, is.numeric, logical(1)))) {
  stop("All ten required columns must contain numeric data.", call. = FALSE)
}

if (anyNA(energy_raw)) {
  stop("The selected dataset contains missing values.", call. = FALSE)
}

names(energy_raw) <- c(
  "RelativeCompactness",
  "SurfaceArea",
  "WallArea",
  "RoofArea",
  "OverallHeight",
  "Orientation",
  "GlazingArea",
  "GlazingAreaDistribution",
