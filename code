# Data Preparation

The Energy Efficiency dataset contains 768 building configurations. Eight building-design variables are used to predict Heating Load (Y1). Cooling Load (Y2) is available in the source dataset but is excluded from the present analysis so that the homework follows a single-response regression framework.

```{r load-data}
# The Excel file should be saved in the same folder as this R Markdown file.
# During knitting, find that folder explicitly instead of relying on RStudio's
# current working directory.
rmd_input <- knitr::current_input(dir = TRUE)

if (is.null(rmd_input) || length(rmd_input) == 0 || !nzchar(rmd_input)) {
  rmd_dir <- getwd()
} else {
  rmd_dir <- dirname(
    normalizePath(rmd_input, winslash = "/", mustWork = FALSE)
  )
}

search_dirs <- unique(c(rmd_dir, getwd()))
preferred_names <- c(
  "ENB2012_data(1).xlsx",
  "ENB2012_data.xlsx"
)

candidate_files <- unlist(
  lapply(search_dirs, function(d) {
    c(
      file.path(d, preferred_names),
      list.files(
        path = d,
        pattern = "^ENB2012_data.*\\.xlsx$",
        full.names = TRUE,
        ignore.case = TRUE
      )
    )
  }),
  use.names = FALSE
)

candidate_files <- unique(candidate_files[file.exists(candidate_files)])

if (length(candidate_files) == 0) {
  stop(
    paste0(
      "Energy Efficiency Excel file not found. Save ENB2012_data.xlsx ",
      "or ENB2012_data(1).xlsx in the same folder as this Rmd file, then knit again."
    ),
    call. = FALSE
  )
}

# Use an absolute normalized path and read_xlsx() explicitly. This avoids
# readxl having to guess the workbook format during knitting.
dataset_path <- normalizePath(
  candidate_files[1],
  winslash = "/",
  mustWork = TRUE
)

energy_raw <- readxl::read_xlsx(
  path = dataset_path,
  sheet = 1
)
energy_raw <- as.data.frame(energy_raw)

required_columns <- c(
  "Relative Compactness(X1)",
  "Surface Area(X2)",
  "Wall Area(X3)",
  "Roof Area(X4)",
  "Overall Height(X5)",
  "Orientation(X6)",
  "Glazing Area(X7)",
  "Glazing Area Distribution(X8)",
  "Heating Load(Y1)",
  "Cooling Load(Y2)"
)

missing_columns <- setdiff(required_columns, names(energy_raw))
extra_columns <- setdiff(names(energy_raw), required_columns)

if (length(missing_columns) > 0) {
  stop(
    "The selected dataset is missing these required columns: ",
    paste(missing_columns, collapse = ", "),
