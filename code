# Non-Linear Regression with Decision Trees

The regression tree is pruned using cross-validation and is limited to at most five splits for a clear, interpretable visualization.

```{r regression-tree, fig.cap="Cross-validated error used to guide regression-tree pruning"}
set.seed(2026)

# Grow a candidate tree first.
fit_tree_full <- rpart::rpart(
  HeatingLoad ~ .,
  data = train_data,
  method = "anova",
  control = rpart::rpart.control(
    cp = 0.001,
    minsplit = 60,
    minbucket = 25,
    maxdepth = 6,
    xval = 10
  )
)

# Review the cross-validated error for candidate tree sizes.
rpart::printcp(fit_tree_full)

old_par <- par(
  col = plot_palette[1],
  col.axis = plot_palette[1],
  col.lab = plot_palette[1]
)
rpart::plotcp(fit_tree_full, main = "")
par(old_par)

# Keep the final explanatory tree compact. Among candidate trees with at most
# five splits, choose the one with the smallest cross-validated error.
cp_table <- fit_tree_full$cptable
max_display_splits <- 5

eligible_rows <- which(cp_table[, "nsplit"] <= max_display_splits)

selected_row <- eligible_rows[
  which.min(cp_table[eligible_rows, "xerror"])
]

selected_cp <- cp_table[selected_row, "CP"]
fit_tree <- rpart::prune(fit_tree_full, cp = selected_cp)

cat("Selected pruning CP:", selected_cp, "\n")
cat("Selected number of splits:", cp_table[selected_row, "nsplit"], "\n")
cat(
  "Terminal nodes before pruning:",
  sum(fit_tree_full$frame$var == "<leaf>"),
  "\n"
)
cat(
  "Terminal nodes after pruning:",
  sum(fit_tree$frame$var == "<leaf>"),
  "\n"
)

print(fit_tree)
```

