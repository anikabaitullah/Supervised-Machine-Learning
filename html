<span id="cb1-123"><a href="#cb1-123" tabindex="-1"></a>  <span class="st">&quot;GlazingAreaDistribution&quot;</span></span>
<span id="cb1-124"><a href="#cb1-124" tabindex="-1"></a>)</span>
<span id="cb1-125"><a href="#cb1-125" tabindex="-1"></a></span>
<span id="cb1-126"><a href="#cb1-126" tabindex="-1"></a><span class="co"># CoolingLoad is intentionally excluded so the analysis has one continuous</span></span>
<span id="cb1-127"><a href="#cb1-127" tabindex="-1"></a><span class="co"># response variable, consistent with the regression workflow used in class.</span></span>
<span id="cb1-128"><a href="#cb1-128" tabindex="-1"></a>energy <span class="ot">&lt;-</span> energy_raw[, <span class="fu">c</span>(predictor_names, <span class="st">&quot;HeatingLoad&quot;</span>)]</span>
