<span id="cb1-113"><a href="#cb1-113" tabindex="-1"></a>)</span>
<span id="cb1-114"><a href="#cb1-114" tabindex="-1"></a></span>
<span id="cb1-115"><a href="#cb1-115" tabindex="-1"></a>predictor_names <span class="ot">&lt;-</span> <span class="fu">c</span>(</span>
<span id="cb1-116"><a href="#cb1-116" tabindex="-1"></a>  <span class="st">&quot;RelativeCompactness&quot;</span>,</span>
<span id="cb1-117"><a href="#cb1-117" tabindex="-1"></a>  <span class="st">&quot;SurfaceArea&quot;</span>,</span>
<span id="cb1-118"><a href="#cb1-118" tabindex="-1"></a>  <span class="st">&quot;WallArea&quot;</span>,</span>
<span id="cb1-119"><a href="#cb1-119" tabindex="-1"></a>  <span class="st">&quot;RoofArea&quot;</span>,</span>
