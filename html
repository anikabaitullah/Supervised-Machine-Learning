<span id="cb35-9"><a href="#cb35-9" tabindex="-1"></a>plot_cv_glmnet_palette <span class="ot">&lt;-</span> <span class="cf">function</span>(</span>
<span id="cb35-10"><a href="#cb35-10" tabindex="-1"></a>  cvfit,</span>
<span id="cb35-11"><a href="#cb35-11" tabindex="-1"></a>  <span class="at">point_col =</span> plot_palette[<span class="dv">2</span>],</span>
<span id="cb35-12"><a href="#cb35-12" tabindex="-1"></a>  <span class="at">error_col =</span> plot_palette[<span class="dv">4</span>],</span>
