<span id="cb1-110"><a href="#cb1-110" tabindex="-1"></a>  <span class="st">&quot;GlazingAreaDistribution&quot;</span>,</span>
<span id="cb1-111"><a href="#cb1-111" tabindex="-1"></a>  <span class="st">&quot;HeatingLoad&quot;</span>,</span>
