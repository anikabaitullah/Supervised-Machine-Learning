<span id="cb35-18"><a href="#cb35-18" tabindex="-1"></a>  x <span class="ot">&lt;-</span> sign_lambda <span class="sc">*</span> <span class="fu">log</span>(cvfit<span class="sc">$</span>lambda)</span>
<span id="cb35-19"><a href="#cb35-19" tabindex="-1"></a>  y <span class="ot">&lt;-</span> cvfit<span class="sc">$</span>cvm</span>
<span id="cb35-20"><a href="#cb35-20" tabindex="-1"></a>  lower <span class="ot">&lt;-</span> cvfit<span class="sc">$</span>cvlo</span>
<span id="cb35-21"><a href="#cb35-21" tabindex="-1"></a>  upper <span class="ot">&lt;-</span> cvfit<span class="sc">$</span>cvup</span>
<span id="cb35-22"><a href="#cb35-22" tabindex="-1"></a></span>
<span id="cb35-23"><a href="#cb35-23" tabindex="-1"></a>  <span class="fu">plot</span>(</span>
<span id="cb35-24"><a href="#cb35-24" tabindex="-1"></a>    x, y,</span>
