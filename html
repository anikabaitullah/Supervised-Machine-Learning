<span id="cb35-56"><a href="#cb35-56" tabindex="-1"></a></span>
<span id="cb35-57"><a href="#cb35-57" tabindex="-1"></a>  <span class="fu">abline</span>(</span>
<span id="cb35-58"><a href="#cb35-58" tabindex="-1"></a>    <span class="at">v =</span> sign_lambda <span class="sc">*</span> <span class="fu">log</span>(cvfit<span class="sc">$</span>lambda.min),</span>
<span id="cb35-59"><a href="#cb35-59" tabindex="-1"></a>    <span class="at">lty =</span> <span class="dv">3</span>,</span>
<span id="cb35-60"><a href="#cb35-60" tabindex="-1"></a>    <span class="at">lwd =</span> <span class="dv">1</span>,</span>
<span id="cb35-61"><a href="#cb35-61" tabindex="-1"></a>    <span class="at">col =</span> line_col</span>
<span id="cb35-62"><a href="#cb35-62" tabindex="-1"></a>  )</span>
<span id="cb35-63"><a href="#cb35-63" tabindex="-1"></a>  <span class="fu">abline</span>(</span>
<span id="cb35-64"><a href="#cb35-64" tabindex="-1"></a>    <span class="at">v =</span> sign_lambda <span class="sc">*</span> <span class="fu">log</span>(cvfit<span class="sc">$</span>lambda<span class="fl">.1</span>se),</span>
<span id="cb35-65"><a href="#cb35-65" tabindex="-1"></a>    <span class="at">lty =</span> <span class="dv">3</span>,</span>
<span id="cb35-66"><a href="#cb35-66" tabindex="-1"></a>    <span class="at">lwd =</span> <span class="dv">1</span>,</span>
<span id="cb35-67"><a href="#cb35-67" tabindex="-1"></a>    <span class="at">col =</span> line_col</span>
<span id="cb35-68"><a href="#cb35-68" tabindex="-1"></a>  )</span>
<span id="cb35-69"><a href="#cb35-69" tabindex="-1"></a></span>
