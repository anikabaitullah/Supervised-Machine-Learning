<span id="cb35-26"><a href="#cb35-26" tabindex="-1"></a>    <span class="at">ylim =</span> <span class="fu">range</span>(<span class="fu">c</span>(lower, upper), <span class="at">finite =</span> <span class="cn">TRUE</span>),</span>
<span id="cb35-27"><a href="#cb35-27" tabindex="-1"></a>    <span class="at">xlab =</span> <span class="fu">expression</span>(<span class="sc">-</span><span class="fu">Log</span>(lambda)),</span>
<span id="cb35-28"><a href="#cb35-28" tabindex="-1"></a>    <span class="at">ylab =</span> <span class="cf">if</span> (<span class="sc">!</span><span class="fu">is.null</span>(cvfit<span class="sc">$</span>name)) cvfit<span class="sc">$</span>name <span class="cf">else</span> <span class="st">&quot;Mean-Squared Error&quot;</span>,</span>
<span id="cb35-29"><a href="#cb35-29" tabindex="-1"></a>    <span class="at">main =</span> <span class="st">&quot;&quot;</span></span>
<span id="cb35-30"><a href="#cb35-30" tabindex="-1"></a>  )</span>
<span id="cb35-31"><a href="#cb35-31" tabindex="-1"></a></span>
<span id="cb35-32"><a href="#cb35-32" tabindex="-1"></a>  cap_width <span class="ot">&lt;-</span> <span class="fu">diff</span>(<span class="fu">range</span>(x)) <span class="sc">/</span> <span class="dv">250</span></span>
<span id="cb35-33"><a href="#cb35-33" tabindex="-1"></a></span>
<span id="cb35-34"><a href="#cb35-34" tabindex="-1"></a>  <span class="fu">segments</span>(</span>
<span id="cb35-35"><a href="#cb35-35" tabindex="-1"></a>    x, lower, x, upper,</span>
