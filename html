<span id="cb35-38"><a href="#cb35-38" tabindex="-1"></a>  )</span>
<span id="cb35-39"><a href="#cb35-39" tabindex="-1"></a>  <span class="fu">segments</span>(</span>
<span id="cb35-40"><a href="#cb35-40" tabindex="-1"></a>    x <span class="sc">-</span> cap_width, lower, x <span class="sc">+</span> cap_width, lower,</span>
<span id="cb35-41"><a href="#cb35-41" tabindex="-1"></a>    <span class="at">col =</span> error_col,</span>
<span id="cb35-42"><a href="#cb35-42" tabindex="-1"></a>    <span class="at">lwd =</span> <span class="dv">1</span></span>
<span id="cb35-43"><a href="#cb35-43" tabindex="-1"></a>  )</span>
<span id="cb35-44"><a href="#cb35-44" tabindex="-1"></a>  <span class="fu">segments</span>(</span>
<span id="cb35-45"><a href="#cb35-45" tabindex="-1"></a>    x <span class="sc">-</span> cap_width, upper, x <span class="sc">+</span> cap_width, upper,</span>
<span id="cb35-46"><a href="#cb35-46" tabindex="-1"></a>    <span class="at">col =</span> error_col,</span>
<span id="cb35-47"><a href="#cb35-47" tabindex="-1"></a>    <span class="at">lwd =</span> <span class="dv">1</span></span>
<span id="cb35-48"><a href="#cb35-48" tabindex="-1"></a>  )</span>
<span id="cb35-49"><a href="#cb35-49" tabindex="-1"></a></span>
<span id="cb35-50"><a href="#cb35-50" tabindex="-1"></a>  <span class="fu">points</span>(</span>
<span id="cb35-51"><a href="#cb35-51" tabindex="-1"></a>    x, y,</span>
