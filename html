<div id="data-preparation" class="section level1">
<h1>Data Preparation</h1>
<p>The Energy Efficiency dataset contains 768 building configurations.
Eight building-design variables are used to predict Heating Load (Y1).
Cooling Load (Y2) is available in the source dataset but is excluded
from the present analysis so that the homework follows a single-response
regression framework.</p>
<div class="sourceCode" id="cb1"><pre class="sourceCode r"><code class="sourceCode r"><span id="cb1-1"><a href="#cb1-1" tabindex="-1"></a><span class="co"># The Excel file should be saved in the same folder as this R Markdown file.</span></span>
<span id="cb1-2"><a href="#cb1-2" tabindex="-1"></a><span class="co"># During knitting, find that folder explicitly instead of relying on RStudio&#39;s</span></span>
<span id="cb1-3"><a href="#cb1-3" tabindex="-1"></a><span class="co"># current working directory.</span></span>
<span id="cb1-4"><a href="#cb1-4" tabindex="-1"></a>rmd_input <span class="ot">&lt;-</span> knitr<span class="sc">::</span><span class="fu">current_input</span>(<span class="at">dir =</span> <span class="cn">TRUE</span>)</span>
<span id="cb1-5"><a href="#cb1-5" tabindex="-1"></a></span>
<span id="cb1-6"><a href="#cb1-6" tabindex="-1"></a><span class="cf">if</span> (<span class="fu">is.null</span>(rmd_input) <span class="sc">||</span> <span class="fu">length</span>(rmd_input) <span class="sc">==</span> <span class="dv">0</span> <span class="sc">||</span> <span class="sc">!</span><span class="fu">nzchar</span>(rmd_input)) {</span>
<span id="cb1-7"><a href="#cb1-7" tabindex="-1"></a>  rmd_dir <span class="ot">&lt;-</span> <span class="fu">getwd</span>()</span>
<span id="cb1-8"><a href="#cb1-8" tabindex="-1"></a>} <span class="cf">else</span> {</span>
<span id="cb1-9"><a href="#cb1-9" tabindex="-1"></a>  rmd_dir <span class="ot">&lt;-</span> <span class="fu">dirname</span>(</span>
<span id="cb1-10"><a href="#cb1-10" tabindex="-1"></a>    <span class="fu">normalizePath</span>(rmd_input, <span class="at">winslash =</span> <span class="st">&quot;/&quot;</span>, <span class="at">mustWork =</span> <span class="cn">FALSE</span>)</span>
<span id="cb1-11"><a href="#cb1-11" tabindex="-1"></a>  )</span>
<span id="cb1-12"><a href="#cb1-12" tabindex="-1"></a>}</span>
<span id="cb1-13"><a href="#cb1-13" tabindex="-1"></a></span>
<span id="cb1-14"><a href="#cb1-14" tabindex="-1"></a>search_dirs <span class="ot">&lt;-</span> <span class="fu">unique</span>(<span class="fu">c</span>(rmd_dir, <span class="fu">getwd</span>()))</span>
<span id="cb1-15"><a href="#cb1-15" tabindex="-1"></a>preferred_names <span class="ot">&lt;-</span> <span class="fu">c</span>(</span>
<span id="cb1-16"><a href="#cb1-16" tabindex="-1"></a>  <span class="st">&quot;ENB2012_data(1).xlsx&quot;</span>,</span>
<span id="cb1-17"><a href="#cb1-17" tabindex="-1"></a>  <span class="st">&quot;ENB2012_data.xlsx&quot;</span></span>
<span id="cb1-18"><a href="#cb1-18" tabindex="-1"></a>)</span>
<span id="cb1-19"><a href="#cb1-19" tabindex="-1"></a></span>
<span id="cb1-20"><a href="#cb1-20" tabindex="-1"></a>candidate_files <span class="ot">&lt;-</span> <span class="fu">unlist</span>(</span>
<span id="cb1-21"><a href="#cb1-21" tabindex="-1"></a>  <span class="fu">lapply</span>(search_dirs, <span class="cf">function</span>(d) {</span>
<span id="cb1-22"><a href="#cb1-22" tabindex="-1"></a>    <span class="fu">c</span>(</span>
<span id="cb1-23"><a href="#cb1-23" tabindex="-1"></a>      <span class="fu">file.path</span>(d, preferred_names),</span>
<span id="cb1-24"><a href="#cb1-24" tabindex="-1"></a>      <span class="fu">list.files</span>(</span>
<span id="cb1-25"><a href="#cb1-25" tabindex="-1"></a>        <span class="at">path =</span> d,</span>
<span id="cb1-26"><a href="#cb1-26" tabindex="-1"></a>        <span class="at">pattern =</span> <span class="st">&quot;^ENB2012_data.*</span><span class="sc">\\</span><span class="st">.xlsx$&quot;</span>,</span>
<span id="cb1-27"><a href="#cb1-27" tabindex="-1"></a>        <span class="at">full.names =</span> <span class="cn">TRUE</span>,</span>
<span id="cb1-28"><a href="#cb1-28" tabindex="-1"></a>        <span class="at">ignore.case =</span> <span class="cn">TRUE</span></span>
<span id="cb1-29"><a href="#cb1-29" tabindex="-1"></a>      )</span>
<span id="cb1-30"><a href="#cb1-30" tabindex="-1"></a>    )</span>
<span id="cb1-31"><a href="#cb1-31" tabindex="-1"></a>  }),</span>
<span id="cb1-32"><a href="#cb1-32" tabindex="-1"></a>  <span class="at">use.names =</span> <span class="cn">FALSE</span></span>
<span id="cb1-33"><a href="#cb1-33" tabindex="-1"></a>)</span>
<span id="cb1-34"><a href="#cb1-34" tabindex="-1"></a></span>
<span id="cb1-35"><a href="#cb1-35" tabindex="-1"></a>candidate_files <span class="ot">&lt;-</span> <span class="fu">unique</span>(candidate_files[<span class="fu">file.exists</span>(candidate_files)])</span>
<span id="cb1-36"><a href="#cb1-36" tabindex="-1"></a></span>
<span id="cb1-37"><a href="#cb1-37" tabindex="-1"></a><span class="cf">if</span> (<span class="fu">length</span>(candidate_files) <span class="sc">==</span> <span class="dv">0</span>) {</span>
<span id="cb1-38"><a href="#cb1-38" tabindex="-1"></a>  <span class="fu">stop</span>(</span>
<span id="cb1-39"><a href="#cb1-39" tabindex="-1"></a>    <span class="fu">paste0</span>(</span>
<span id="cb1-40"><a href="#cb1-40" tabindex="-1"></a>      <span class="st">&quot;Energy Efficiency Excel file not found. Save ENB2012_data.xlsx &quot;</span>,</span>
<span id="cb1-41"><a href="#cb1-41" tabindex="-1"></a>      <span class="st">&quot;or ENB2012_data(1).xlsx in the same folder as this Rmd file, then knit again.&quot;</span></span>
<span id="cb1-42"><a href="#cb1-42" tabindex="-1"></a>    ),</span>
<span id="cb1-43"><a href="#cb1-43" tabindex="-1"></a>    <span class="at">call. =</span> <span class="cn">FALSE</span></span>
<span id="cb1-44"><a href="#cb1-44" tabindex="-1"></a>  )</span>
<span id="cb1-45"><a href="#cb1-45" tabindex="-1"></a>}</span>
<span id="cb1-46"><a href="#cb1-46" tabindex="-1"></a></span>
<span id="cb1-47"><a href="#cb1-47" tabindex="-1"></a><span class="co"># Use an absolute normalized path and read_xlsx() explicitly. This avoids</span></span>
<span id="cb1-48"><a href="#cb1-48" tabindex="-1"></a><span class="co"># readxl having to guess the workbook format during knitting.</span></span>
<span id="cb1-49"><a href="#cb1-49" tabindex="-1"></a>dataset_path <span class="ot">&lt;-</span> <span class="fu">normalizePath</span>(</span>
<span id="cb1-50"><a href="#cb1-50" tabindex="-1"></a>  candidate_files[<span class="dv">1</span>],</span>
<span id="cb1-51"><a href="#cb1-51" tabindex="-1"></a>  <span class="at">winslash =</span> <span class="st">&quot;/&quot;</span>,</span>
<span id="cb1-52"><a href="#cb1-52" tabindex="-1"></a>  <span class="at">mustWork =</span> <span class="cn">TRUE</span></span>
<span id="cb1-53"><a href="#cb1-53" tabindex="-1"></a>)</span>
<span id="cb1-54"><a href="#cb1-54" tabindex="-1"></a></span>
<span id="cb1-55"><a href="#cb1-55" tabindex="-1"></a>energy_raw <span class="ot">&lt;-</span> readxl<span class="sc">::</span><span class="fu">read_xlsx</span>(</span>
<span id="cb1-56"><a href="#cb1-56" tabindex="-1"></a>  <span class="at">path =</span> dataset_path,</span>
<span id="cb1-57"><a href="#cb1-57" tabindex="-1"></a>  <span class="at">sheet =</span> <span class="dv">1</span></span>
<span id="cb1-58"><a href="#cb1-58" tabindex="-1"></a>)</span>
<span id="cb1-59"><a href="#cb1-59" tabindex="-1"></a>energy_raw <span class="ot">&lt;-</span> <span class="fu">as.data.frame</span>(energy_raw)</span>
<span id="cb1-60"><a href="#cb1-60" tabindex="-1"></a></span>
<span id="cb1-61"><a href="#cb1-61" tabindex="-1"></a>required_columns <span class="ot">&lt;-</span> <span class="fu">c</span>(</span>
<span id="cb1-62"><a href="#cb1-62" tabindex="-1"></a>  <span class="st">&quot;Relative Compactness(X1)&quot;</span>,</span>
<span id="cb1-63"><a href="#cb1-63" tabindex="-1"></a>  <span class="st">&quot;Surface Area(X2)&quot;</span>,</span>
<span id="cb1-64"><a href="#cb1-64" tabindex="-1"></a>  <span class="st">&quot;Wall Area(X3)&quot;</span>,</span>
<span id="cb1-65"><a href="#cb1-65" tabindex="-1"></a>  <span class="st">&quot;Roof Area(X4)&quot;</span>,</span>
<span id="cb1-66"><a href="#cb1-66" tabindex="-1"></a>  <span class="st">&quot;Overall Height(X5)&quot;</span>,</span>
<span id="cb1-67"><a href="#cb1-67" tabindex="-1"></a>  <span class="st">&quot;Orientation(X6)&quot;</span>,</span>
<span id="cb1-68"><a href="#cb1-68" tabindex="-1"></a>  <span class="st">&quot;Glazing Area(X7)&quot;</span>,</span>
<span id="cb1-69"><a href="#cb1-69" tabindex="-1"></a>  <span class="st">&quot;Glazing Area Distribution(X8)&quot;</span>,</span>
<span id="cb1-70"><a href="#cb1-70" tabindex="-1"></a>  <span class="st">&quot;Heating Load(Y1)&quot;</span>,</span>
<span id="cb1-71"><a href="#cb1-71" tabindex="-1"></a>  <span class="st">&quot;Cooling Load(Y2)&quot;</span></span>
<span id="cb1-72"><a href="#cb1-72" tabindex="-1"></a>)</span>
<span id="cb1-73"><a href="#cb1-73" tabindex="-1"></a></span>
<span id="cb1-74"><a href="#cb1-74" tabindex="-1"></a>missing_columns <span class="ot">&lt;-</span> <span class="fu">setdiff</span>(required_columns, <span class="fu">names</span>(energy_raw))</span>
<span id="cb1-75"><a href="#cb1-75" tabindex="-1"></a>extra_columns <span class="ot">&lt;-</span> <span class="fu">setdiff</span>(<span class="fu">names</span>(energy_raw), required_columns)</span>
<span id="cb1-76"><a href="#cb1-76" tabindex="-1"></a></span>
<span id="cb1-77"><a href="#cb1-77" tabindex="-1"></a><span class="cf">if</span> (<span class="fu">length</span>(missing_columns) <span class="sc">&gt;</span> <span class="dv">0</span>) {</span>
<span id="cb1-78"><a href="#cb1-78" tabindex="-1"></a>  <span class="fu">stop</span>(</span>
<span id="cb1-79"><a href="#cb1-79" tabindex="-1"></a>    <span class="st">&quot;The selected dataset is missing these required columns: &quot;</span>,</span>
<span id="cb1-80"><a href="#cb1-80" tabindex="-1"></a>    <span class="fu">paste</span>(missing_columns, <span class="at">collapse =</span> <span class="st">&quot;, &quot;</span>),</span>
<span id="cb1-81"><a href="#cb1-81" tabindex="-1"></a>    <span class="at">call. =</span> <span class="cn">FALSE</span></span>
<span id="cb1-82"><a href="#cb1-82" tabindex="-1"></a>  )</span>
<span id="cb1-83"><a href="#cb1-83" tabindex="-1"></a>}</span>
<span id="cb1-84"><a href="#cb1-84" tabindex="-1"></a></span>
<span id="cb1-85"><a href="#cb1-85" tabindex="-1"></a><span class="cf">if</span> (<span class="fu">length</span>(extra_columns) <span class="sc">&gt;</span> <span class="dv">0</span>) {</span>
<span id="cb1-86"><a href="#cb1-86" tabindex="-1"></a>  <span class="fu">message</span>(</span>
<span id="cb1-87"><a href="#cb1-87" tabindex="-1"></a>    <span class="st">&quot;Additional columns will not be used in this analysis: &quot;</span>,</span>
<span id="cb1-88"><a href="#cb1-88" tabindex="-1"></a>    <span class="fu">paste</span>(extra_columns, <span class="at">collapse =</span> <span class="st">&quot;, &quot;</span>)</span>
<span id="cb1-89"><a href="#cb1-89" tabindex="-1"></a>  )</span>
<span id="cb1-90"><a href="#cb1-90" tabindex="-1"></a>}</span>
<span id="cb1-91"><a href="#cb1-91" tabindex="-1"></a></span>
<span id="cb1-92"><a href="#cb1-92" tabindex="-1"></a>energy_raw <span class="ot">&lt;-</span> energy_raw[, required_columns]</span>
<span id="cb1-93"><a href="#cb1-93" tabindex="-1"></a></span>
<span id="cb1-94"><a href="#cb1-94" tabindex="-1"></a><span class="cf">if</span> (<span class="sc">!</span><span class="fu">all</span>(<span class="fu">vapply</span>(energy_raw, is.numeric, <span class="fu">logical</span>(<span class="dv">1</span>)))) {</span>
<span id="cb1-95"><a href="#cb1-95" tabindex="-1"></a>  <span class="fu">stop</span>(<span class="st">&quot;All ten required columns must contain numeric data.&quot;</span>, <span class="at">call. =</span> <span class="cn">FALSE</span>)</span>
<span id="cb1-96"><a href="#cb1-96" tabindex="-1"></a>}</span>
<span id="cb1-97"><a href="#cb1-97" tabindex="-1"></a></span>
<span id="cb1-98"><a href="#cb1-98" tabindex="-1"></a><span class="cf">if</span> (<span class="fu">anyNA</span>(energy_raw)) {</span>
<span id="cb1-99"><a href="#cb1-99" tabindex="-1"></a>  <span class="fu">stop</span>(<span class="st">&quot;The selected dataset contains missing values.&quot;</span>, <span class="at">call. =</span> <span class="cn">FALSE</span>)</span>
<span id="cb1-100"><a href="#cb1-100" tabindex="-1"></a>}</span>
<span id="cb1-101"><a href="#cb1-101" tabindex="-1"></a></span>
<span id="cb1-102"><a href="#cb1-102" tabindex="-1"></a><span class="fu">names</span>(energy_raw) <span class="ot">&lt;-</span> <span class="fu">c</span>(</span>
<span id="cb1-103"><a href="#cb1-103" tabindex="-1"></a>  <span class="st">&quot;RelativeCompactness&quot;</span>,</span>
<span id="cb1-104"><a href="#cb1-104" tabindex="-1"></a>  <span class="st">&quot;SurfaceArea&quot;</span>,</span>
<span id="cb1-105"><a href="#cb1-105" tabindex="-1"></a>  <span class="st">&quot;WallArea&quot;</span>,</span>
<span id="cb1-106"><a href="#cb1-106" tabindex="-1"></a>  <span class="st">&quot;RoofArea&quot;</span>,</span>
<span id="cb1-107"><a href="#cb1-107" tabindex="-1"></a>  <span class="st">&quot;OverallHeight&quot;</span>,</span>
